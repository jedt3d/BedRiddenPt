{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\"); [ -x \"$root/tool/hooks/claude_stop.sh\" ] || exit 0; \"$root/tool/hooks/claude_stop.sh\""
          }
        ]
      }
    ]
  }
}
